# Dependency resolution order:  vcpkg/find_package  ->  system  ->  third_party/ or FetchContent.
# Every dependency ends up as a dscoop::<name> target so the rest of the tree does not care.
include(FetchContent)

# ---- ENet -----------------------------------------------------------------
if(NOT DSCOOP_VENDORED_DEPS)
    find_package(unofficial-enet CONFIG QUIET)      # vcpkg
endif()
if(TARGET unofficial::enet::enet)
    add_library(dscoop_enet_vcpkg INTERFACE)
    target_link_libraries(dscoop_enet_vcpkg INTERFACE unofficial::enet::enet)
    add_library(dscoop::enet ALIAS dscoop_enet_vcpkg)
    message(STATUS "enet: vcpkg")
else()
    find_library(ENET_SYSTEM_LIB enet)
    find_path(ENET_SYSTEM_INC enet/enet.h)
    if(NOT DSCOOP_VENDORED_DEPS AND ENET_SYSTEM_LIB AND ENET_SYSTEM_INC AND NOT CMAKE_CROSSCOMPILING)
        add_library(dscoop_enet_sys INTERFACE)
        target_link_libraries(dscoop_enet_sys INTERFACE ${ENET_SYSTEM_LIB})
        target_include_directories(dscoop_enet_sys INTERFACE ${ENET_SYSTEM_INC})
        add_library(dscoop::enet ALIAS dscoop_enet_sys)
        message(STATUS "enet: system (${ENET_SYSTEM_LIB})")
    else()
        add_subdirectory(${CMAKE_SOURCE_DIR}/third_party/enet EXCLUDE_FROM_ALL)
        message(STATUS "enet: vendored third_party/enet")
    endif()
endif()

