# ---- nlohmann-json ---------------------------------------------------------
if(NOT DSCOOP_VENDORED_DEPS)
    find_package(nlohmann_json CONFIG QUIET)
endif()
if(TARGET nlohmann_json::nlohmann_json)
    add_library(dscoop_json INTERFACE)
    target_link_libraries(dscoop_json INTERFACE nlohmann_json::nlohmann_json)
    add_library(dscoop::json ALIAS dscoop_json)
    message(STATUS "nlohmann-json: find_package")
else()
    if(CMAKE_CROSSCOMPILING)
        find_path(NLOHMANN_INC nlohmann/json.hpp HINTS ${NLOHMANN_JSON_DIR} NO_DEFAULT_PATH CMAKE_FIND_ROOT_PATH_BOTH)
    else()
        find_path(NLOHMANN_INC nlohmann/json.hpp HINTS ${NLOHMANN_JSON_DIR})
    endif()
    if(NLOHMANN_INC)
        add_library(dscoop_json INTERFACE)
        target_include_directories(dscoop_json SYSTEM INTERFACE ${NLOHMANN_INC})
        add_library(dscoop::json ALIAS dscoop_json)
        message(STATUS "nlohmann-json: header at ${NLOHMANN_INC}")
    else()
        FetchContent_Declare(nlohmann_json URL https://github.com/nlohmann/json/releases/download/v3.11.3/json.tar.xz)
        FetchContent_MakeAvailable(nlohmann_json)
        add_library(dscoop_json INTERFACE)
        target_link_libraries(dscoop_json INTERFACE nlohmann_json::nlohmann_json)
        add_library(dscoop::json ALIAS dscoop_json)
        message(STATUS "nlohmann-json: FetchContent")
    endif()
endif()

# ---- spdlog ----------------------------------------------------------------
if(NOT DSCOOP_VENDORED_DEPS)
    find_package(spdlog CONFIG QUIET)
endif()
if(TARGET spdlog::spdlog)
    add_library(dscoop_spdlog INTERFACE)
    target_link_libraries(dscoop_spdlog INTERFACE spdlog::spdlog)
    add_library(dscoop::spdlog ALIAS dscoop_spdlog)
    message(STATUS "spdlog: find_package")
else()
    if(CMAKE_CROSSCOMPILING)
        # Header-only copies staged outside the host sysroot (e.g. scripts/build-mingw.sh does this).
        find_path(SPDLOG_INC spdlog/spdlog.h HINTS ${SPDLOG_DIR} NO_DEFAULT_PATH CMAKE_FIND_ROOT_PATH_BOTH)
        find_path(FMT_INC fmt/format.h HINTS ${FMT_DIR} NO_DEFAULT_PATH CMAKE_FIND_ROOT_PATH_BOTH)
    else()
        find_path(SPDLOG_INC spdlog/spdlog.h HINTS ${SPDLOG_DIR})
        find_path(FMT_INC fmt/format.h HINTS ${FMT_DIR})
    endif()
    if(SPDLOG_INC AND FMT_INC)
        # Header-only mode: works for native and cross builds alike.
        add_library(dscoop_spdlog INTERFACE)
        target_include_directories(dscoop_spdlog SYSTEM INTERFACE ${SPDLOG_INC} ${FMT_INC})
        target_compile_definitions(dscoop_spdlog INTERFACE SPDLOG_HEADER_ONLY SPDLOG_FMT_EXTERNAL FMT_HEADER_ONLY)
        add_library(dscoop::spdlog ALIAS dscoop_spdlog)
        message(STATUS "spdlog: header-only from ${SPDLOG_INC}")
    else()
        FetchContent_Declare(spdlog URL https://github.com/gabime/spdlog/archive/refs/tags/v1.14.1.tar.gz)
        set(SPDLOG_BUILD_EXAMPLE OFF CACHE BOOL "" FORCE)
        FetchContent_MakeAvailable(spdlog)
        add_library(dscoop_spdlog INTERFACE)
        target_link_libraries(dscoop_spdlog INTERFACE spdlog::spdlog)
        add_library(dscoop::spdlog ALIAS dscoop_spdlog)
        message(STATUS "spdlog: FetchContent")
    endif()
endif()

# ---- ImGui (plugin overlay, Windows) -------------------------------------
if(DSCOOP_BUILD_PLUGIN AND DSCOOP_WITH_IMGUI)
    if(NOT DSCOOP_VENDORED_DEPS)
        find_package(imgui CONFIG QUIET)
    endif()
    if(TARGET imgui::imgui)
        add_library(dscoop_imgui_vcpkg INTERFACE)
        target_link_libraries(dscoop_imgui_vcpkg INTERFACE imgui::imgui d3d12 dxgi d3dcompiler dwmapi)
        add_library(dscoop::imgui ALIAS dscoop_imgui_vcpkg)
        message(STATUS "imgui: vcpkg (expects features dx12-binding,win32-binding)")
    else()
        if(NOT IMGUI_DIR)
            FetchContent_Declare(imgui_src URL https://github.com/ocornut/imgui/archive/refs/tags/v1.91.5.tar.gz)
            FetchContent_MakeAvailable(imgui_src)
            set(IMGUI_DIR ${imgui_src_SOURCE_DIR})
        endif()
        if(MINGW)
            set(IMGUI_DX12_BACKEND ${CMAKE_SOURCE_DIR}/src/plugin/src/imgui_impl_dx12_mingw.cpp)
        else()
            set(IMGUI_DX12_BACKEND ${IMGUI_DIR}/backends/imgui_impl_dx12.cpp)
        endif()
        add_library(dscoop_imgui STATIC
            ${IMGUI_DIR}/imgui.cpp ${IMGUI_DIR}/imgui_draw.cpp ${IMGUI_DIR}/imgui_tables.cpp
            ${IMGUI_DIR}/imgui_widgets.cpp ${IMGUI_DIR}/imgui_demo.cpp
            ${IMGUI_DX12_BACKEND} ${IMGUI_DIR}/backends/imgui_impl_win32.cpp)
        target_include_directories(dscoop_imgui SYSTEM PUBLIC ${IMGUI_DIR} ${IMGUI_DIR}/backends)
        target_link_libraries(dscoop_imgui PUBLIC d3d12 dxgi d3dcompiler dwmapi)
        add_library(dscoop::imgui ALIAS dscoop_imgui)
        message(STATUS "imgui: sources at ${IMGUI_DIR}")
    endif()
endif()
