# Common warning set applied via dscoop::warnings interface target.
add_library(dscoop_warnings INTERFACE)
add_library(dscoop::warnings ALIAS dscoop_warnings)
if(MSVC)
    target_compile_options(dscoop_warnings INTERFACE /W4 /permissive- /Zc:__cplusplus /utf-8)
    target_compile_definitions(dscoop_warnings INTERFACE _CRT_SECURE_NO_WARNINGS NOMINMAX WIN32_LEAN_AND_MEAN)
    if(DSCOOP_WARNINGS_AS_ERRORS)
        target_compile_options(dscoop_warnings INTERFACE /WX)
    endif()
else()
    target_compile_options(dscoop_warnings INTERFACE -Wall -Wextra -Wpedantic -Wshadow -Wconversion -Wno-sign-conversion)
    if(WIN32)
        target_compile_definitions(dscoop_warnings INTERFACE NOMINMAX WIN32_LEAN_AND_MEAN)
    endif()
    if(DSCOOP_WARNINGS_AS_ERRORS)
        target_compile_options(dscoop_warnings INTERFACE -Werror)
    endif()
endif()
